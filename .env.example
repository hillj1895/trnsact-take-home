# Copy to .env. Matches docker-compose.yml (`pnpm db:up`).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inventory

# Destructive integration tests (packages/db) only run when this is set. Use a throwaway DB.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/inventory_test
# Also used by `pnpm test:scenarios` (end-to-end change scenarios against the mock dealer).
